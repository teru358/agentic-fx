# MT5 bridge 設定。このファイルを `.env` にコピーして値を設定する (.env は git 管理しない)

# ── MT5 ログイン情報 ──
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=             # MT5 端末のログイン画面の「サーバー」欄に表示される名前

# ── 待受 ──
# 既定は自機内のみ (127.0.0.1)。afx が別マシンにある場合だけ、届く最小の範囲のアドレスに変える。
# 127.0.0.1 / ::1 / localhost 以外にするときは BRIDGE_API_KEY が必須 (空だと起動を拒否する)。
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8812

# API キー (X-Bridge-Api-Key ヘッダ)。
# 空: 価格取得系は認証なしで動くが、発注系 endpoint (/order、modify、close、/admin/halt、/admin/resume) は
#     DRY_RUN に関係なく 403 で拒否される。
# 設定: 全 endpoint でヘッダが必須。afx 側の .env には同じ値を MT5_BRIDGE_API_KEY として書く。
BRIDGE_API_KEY=

# ── 安全フラグ ──
# true: 発注系は約定のシミュレーションだけを返し、MT5 へは発注しない。
# false: 実発注する (API キーが必須)。
DRY_RUN=true

# hard halt フラグファイル。存在すれば DRY_RUN=true 相当で起動する。
# /admin/halt の mode=hard で作られ、削除して DRY_RUN を戻せば再開できる
HALT_STATE_PATH=logs/hard_halt.flag

# 約定方式 (IOC / FOK / RETURN)。ブローカーが対応する方式を指定する
FILLING_MODE=IOC

# slippage 許容 (points 単位、1 pip = 10 points が一般的)
DEVIATION_POINTS=30

# ── サーバ時刻オフセット ──
# MT5 が返す時刻はブローカーのサーバ時間帯のエポック秒 (UTC ではない)。
# bridge は tick から実測して補正する。検出した値をここに永続化し、
# 週末をまたぐ再起動でも良い値を保つ (無ければ起動直後は 503 で fail closed)。
SERVER_OFFSET_PATH=logs/server_offset.json

# オフセット検出だけに使う symbol。常時 tick が流れる主要通貨ペアを指定する
SERVER_TIME_SYMBOL=USDJPY
