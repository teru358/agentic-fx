# agentic-fx 設定 (このファイルを settings.yaml にコピーして編集。新キー追加時は両方を同期)
display_timezone: Asia/Tokyo  # ログ・status 表示に使う (保存は常に UTC、市場境界は NY 固定で変更不可)
account_currency: JPY         # 利用者の基準通貨。損益・リスクの表現と換算に使う。取引可能ペアを制限するものではない (設計書 §5)。実取引では MT5 口座通貨が真で、起動時に照合する

pairs: [USDJPY]  # EURUSD 等クォート通貨が口座通貨と異なるペアは、口座通貨換算の実装 (為替レート取得) 後に有効化する

risk:
  rr_min: 1.5                 # 最小リスク報酬比 (spread 込み)
  risk_per_trade_pct: 0.5     # 1 取引リスク上限 (% of equity)
  swing_risk_factor: 0.5      # horizon=swing のリスク率係数 (常時半減)
  max_positions: 2            # 未約定指値も枠にカウント
  max_total_risk_pct: 1.5     # 最大総エクスポージャー: 全ポジション + 未約定指値の予約リスク合算 (% of equity)
  max_leverage: 10            # 必要証拠金ベースのレバレッジ上限
  daily_loss_limit_pct: 1.0   # 日初エクイティ比
  drawdown_kill_pct: 2.0      # HWM 比。kill switch 自体の無効化キーは存在しない
  limit_deviation_pct: 0.5    # 指値の現値乖離上限
  limit_expiry_max_h: 24
  max_slippage_pct: 0.1
  friday_swing_cutoff_ny: "14:00"  # NY 現地時間。市場クローズ (NY 金 17:00) からの逆算で指定する。この時刻以降の新規 swing 建て禁止
  commission_per_lot: 0.0     # 往復手数料 (口座通貨建て、sizing のリスク額に算入)
  pair_rules:                 # ペア毎の SL 距離制約 + 想定 spread (設計書 §5: SL 距離は pair 毎 config)
    USDJPY: {sl_distance_min_pips: 5, sl_distance_max_pips: 200, assumed_spread_pips: 1.0}
    EURUSD: {sl_distance_min_pips: 5, sl_distance_max_pips: 200, assumed_spread_pips: 1.0}

runner:
  trade:   {backend: local, model: qwen3.6-35b-a3b_Q4}   # backend: local | claude (codex/opencode は拒否)
  improve: {backend: local, model: qwen3-coder-30b-a3b-instruct}   # backend: local | claude | codex | opencode。ローカル LLM は opencode を使う (2026-08-30 裁定)、codex は chatgpt 専用
  claude:
    bin: claude
    credentials_file: ~/.claude/.credentials.json
  codex:
    bin: /path/to/vendor/x86_64-unknown-linux-musl/bin/codex   # プレースホルダのまま (未設定) — codex backend を使うには実バイナリの絶対パスへ書き換えが必須。個人 settings.yaml でこの値を実パスに置き換えないと codex backend は起動できない
    provider: chatgpt   # chatgpt のみ
    auth_file: ~/.codex/auth.json
  opencode:
    bin: ~/.opencode/bin/opencode
    context_limit: 0   # opencode backend を使うときは必ず llama-swap の --ctx-size (= ~/.config/opencode/opencode.jsonc の limit.context) と同じ値に書き換える。0 のままだと起動拒否。モデルを切り替えたら同時に更新
  cli_terminate_grace_sec: 10.0

backtest:                      # コア所有 (§6) — holdout_months の変更は人間レビュー必須
  holdout_months: 3
  initial_balance: 1000000
  eval_source: "dukascopy"     # 評価用 history source。IMPORT_SOURCES のいずれか
  base_interval: "1m"          # バックテスト基底足。1m/5m/15m。ライブの datafeed.intervals とは別軸

llama_swap:
  base_url: "http://localhost:8080/v1"
  timeout_sec: 300
  max_turns: 16

datafeed:
  yfinance:   {enabled: true}
  mt5:        {enabled: false, bridge_url: "http://localhost:8812"}
  twelvedata: {enabled: false}
  freshness_max_min: 20       # これより古い quote/bar は不健全扱い
  conversion_skew_max_min: 5  # 換算レート (口座通貨換算) のクロス脚間・判断内スナップショットの時刻差許容。freshness_max_min より必ず小さいこと (同じ/大きいと skew 検証が発火しなくなる)
  intervals: [1m, 5m, 15m, 1h, 4h]   # 取得・保持する足 (1m は必須: ペーパー約定判定が依存)
  primary_intervals: [1h]            # 判断 Mission が依存する足 (healthcheck の対象)。増やすほど単一障害点も増える
  watch_symbols: []           # 取引不可・分析専用 (§6)。pair enum には入れない
  cache_retention_days: 30    # ohlcv_cache の保持期間 (日)。intervals の構成が要求する最小日数を下回ると起動拒否 (プラン9 Task16)

news:
  cleanup_hours: 48

schedule:
  trade_interval_min: 60
  improve: weekly             # weekly | daily
  improve_at: "Sat 03:00"     # weekly は "<weekday> HH:MM"、daily は "HH:MM" (表示 TZ)

improve:
  parallel: 1
  mission_max_turns: 200
  mission_timeout_sec: 3600
  llama_swap_verified: false
  max_new_backlog_per_mission: 20
  backtest_rpc_timeout_sec: 600
  research:
    max_searches: 20
    max_fetches: 30
    min_interval_sec: 2.0
    max_per_host: 5
    fetch_max_bytes: 2097152
    user_agent: "agentic-fx/0.1 (+https://github.com/agentic-fx/agentic-fx)"
  gate:
    # plugin gate で要求する self-test (`test_*`) の最低本数。
    min_test_functions: 3

logging:
  level: INFO

api:
  enabled: false
  host: 127.0.0.1
  port: 8420

discord:
  enabled: false              # webhook 通知 (URL は .env の DISCORD_WEBHOOK_URL)

analysis:                      # コア所有 (§6 履歴分析)
  max_watch_symbols: 10
  max_gap_pct: 5.0

paper:
  starting_balance: 1000000   # 学習モードの初期残高 (口座通貨建て)

plugin:                        # plugin サンドボックス (プラン 7 Task 2)。省略可 (既定値でロード可能)
  sandbox_timeout_sec: 10       # 1 回の call() (indicator/signal/strategy 呼び出し) の待ち上限
  sandbox_session_cpu_sec: 60   # RLIMIT_CPU: worker プロセス (1 セッション) 寿命の累積 CPU 秒数上限
  sandbox_memory_mb: 512        # RLIMIT_AS: 仮想アドレス空間上限 (MiB)
  sandbox_output_max_bytes: 1048576  # 1 応答行の生バイト数上限
  sandbox_nofile: 128           # RLIMIT_NOFILE: worker が同時に開けるファイル記述子数の上限
  sandbox_fsize_mb: 8           # RLIMIT_FSIZE (MiB): 1 ファイルあたりの書き込みサイズ上限。pytest サブプロセスにも流用
  max_bars_limit: 1000          # plugin config.yaml の max_bars 上限。discover では照合しない — 承認 (submit/bless) と get_indicators (indicator 合成) で照合し、超過は拒否する
  producer_source: yfinance     # 本番 producer が signal/strategy plugin を評価する際の data source (プラン 7 Task 6)
  signal_requeue_max: 2          # signals の requeue 上限 (超えたら abandoned)
  signal_lease_min: 15           # signals claim の lease 時間 (分。超過で reclaim_expired の回収対象)
  signal_freshness_bars: 2       # signals 鮮度ゲート: 宣言 timeframe の何バー分まで新鮮とみなすか
  signal_min_interval_min: 10    # signal トリガー取引判断 Mission の最短起動間隔 (分)
  signal_daily_max: 12           # signal トリガー取引判断 Mission の日次上限
  signals_max_lookback_hours: 24 # get_signals ツールの since_hours 上限 (プラン 7 Task 9)
  pytest_timeout_sec: 300        # submit/bless/改善ループ候補ゲートの pytest 実行タイムアウト (プラン10 Task 6)

worker:                        # mission worker (プラン8) の resource limit・preemption・IPC 設定。省略可
  child_as_mb: 4096             # RLIMIT_AS (MiB): 実測 VmPeak 1.65GB (32コア環境) の約2.4倍の余裕。多コア機では要再実測 (IM-9)
  child_nofile: 128             # RLIMIT_NOFILE
  child_fsize_mb: 8             # RLIMIT_FSIZE (MiB): 正常経路ではファイルを書かない前提の小さい上限
  worker_grace_sec: 30          # runner soft deadline の外側マージン (壁時計監視)
  worker_terminate_grace_sec: 10  # SIGTERM 後 SIGKILL までの猶予
  worker_startup_timeout_sec: 30  # 子の import〜ready まで
  transcript_max_bytes: 1048576   # Mission 累積 transcript 上限 (超過は truncate marker)
  data_hook_timeout_sec: 30       # tick 内データ hooks の全ネットワーククライアント timeout 上限
  rpc_timeout_sec: 15             # RAG RPC の親側応答待ち上限
  shutdown_join_timeout_sec: 30   # 停止シーケンスの join 上限
  snapshot_max_age_sec: 10        # commit-pre スナップショットの許容鮮度 (秒)。超過は発注拒否 (lock内再取得しない)

reflection:                    # reflection cycle の再試行ポリシー (プラン9 Task15)。省略可
  max_attempts: 2               # 同一 order の reflection 再試行上限。到達で abandon (reflect retry <id> で復帰)

alert:                         # 運用アラート (プラン9 Task17)。省略可
  consecutive_gate_reject: 10   # risk gate の連続 rejection がこの本数に達したら一度だけ通知
