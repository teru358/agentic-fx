# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets / personal config
.env
config/settings.yaml
policy/directives.md

# Local data / logs / personal notes
data/
logs/
reports/
CLAUDE.md

# LLM-generated plugins (differ per user, approved locally — see design doc
# §6)。**リポジトリ直下のみ** — 末尾 `/` だけの無錨パターンは
# `docs/examples/plugins/` (コミット対象のサンプル) も任意の深さで拾って
# しまうため先頭 `/` で錨止めする (プラン 7 Task 1 レビュー指摘)。
/plugins/

# エディタの一時ファイル
*.swp
*.swo
*~

# SDD 作業文書 (レビュー/修整ログ — ローカル運用、未追跡)
/.superpowers/

# 一時ファイル置き場 (2026-08-10 ユーザー方針: 一時ファイルは /tmp か tmp/ に置く)
/tmp/

# git worktree (並列レーン用 — リポジトリに入れない)
.worktrees/
