{
 "contract": "afx ctl が鍵 (Authorization) を送る前に行う server 認証。判定順は 親 dir (lstat: dir・所有者・0700) → socket (lstat: socket・所有者) → 接続 → SO_PEERCRED uid → SO_PEERPIDFD (ESRCH は拒否、無ければ省略) → /proc/locks の FLOCK WRITE 保持者が {peer pid} と一致 → 保持者の生存",
 "expect_fields": {
  "decision": "allow = 鍵を送る / reject = 鍵を送らない",
  "rc": "afx ctl whoami の終了コード (allow は偽 daemon が成功応答を返すので 0、reject は 3)",
  "reason": "reject のとき stderr に出る固定語 (client.ServerAuthError.reason)",
  "key_sent": "偽 daemon が Authorization を受信したか",
  "pre_auth_bytes": "reject のとき、偽 daemon が受信した bytes の合計 (接続しない場合も 0)"
 },
 "setup_fields": {
  "socket": "socket | regular_file | symlink_to_socket | socket_of_other_uid",
  "dir": "real | symlink (data/run の実体)",
  "dir_mode": "data/run の mode",
  "client_uid": "self | other (client が期待する uid)",
  "server_lock": "held | none | other_process | replaced_inode | multiple",
  "server_process": "alive | exited_after_listen | zombie_after_listen | other_uid",
  "pidfd": "(省略時は kernel のまま) unsupported | esrch | pid_mismatch",
  "proc_locks": "(省略時は読める) unreadable",
  "filesystem": "(省略時は dev 一致) dev_mismatch"
 },
 "cases": [
  {
   "id": "baseline_lock_holder",
   "axis": "保持者照合 (一致)",
   "setup": {
    "socket": "socket",
    "dir": "real",
    "dir_mode": "0700",
    "client_uid": "self",
    "server_lock": "held",
    "server_process": "alive"
   },
   "realizable": true,
   "expect": {
    "decision": "allow",
    "rc": 0,
    "reason": null,
    "key_sent": true
   }
  },
